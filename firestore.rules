// Safe starting point for taipei_cultural_adventure.
// This file is NOT deployed automatically from GitHub Pages.
// Do not replace with allow read, write: if true.
// Design and test authenticated, group-scoped rules before enabling client access.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
