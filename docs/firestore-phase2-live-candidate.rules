// LOCAL REVIEW CANDIDATE ONLY — NEVER deploy without reconciling current live rules.
// Preserves legacy invitation flow from firestore-group-draft.rules.
// Phase2 students join ONLY via Admin SDK Callable; client cannot write membership.
// Group documents contain joinTokenHash: never expose to students.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function teacher(){
   return signedIn() &&
    exists(/databases/$(database)/documents/teacherAccess/$(request.auth.uid)) &&
    get(/databases/$(database)/documents/teacherAccess/$(request.auth.uid)).data.authorized == true;
  }
  function enrolled(activityId,groupId){
   return signedIn() &&
    exists(/databases/$(database)/documents/activities/$(activityId)/groups/$(groupId)/members/$(request.auth.uid)) &&
    get(/databases/$(database)/documents/activities/$(activityId)/groups/$(groupId)/members/$(request.auth.uid)).data.get('revoked',false) != true;
  }
  match /teacherAccess/{uid}{
   allow get: if signedIn() && request.auth.uid == uid;
   allow list,create,update,delete: if false;
  }
  match /invites/{token}{
   allow get: if signedIn() && token.matches('^[a-fA-F0-9]{48}$');
   allow list,create,delete: if false;
   allow update: if signedIn() && resource.data.claimedBy == null
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy','claimedAt'])
    && request.resource.data.claimedBy == request.auth.uid
    && request.resource.data.claimedAt == request.time
    && existsAfter(/databases/$(database)/documents/activities/$(resource.data.activityId)/groups/$(resource.data.groupId)/members/$(request.auth.uid))
    && getAfter(/databases/$(database)/documents/activities/$(resource.data.activityId)/groups/$(resource.data.groupId)/members/$(request.auth.uid)).data.inviteId == token;
  }
  match /activities/{activityId}{
   allow get: if teacher();
   allow list,create,update,delete: if false;
   match /groups/{groupId}{
    // Phase2 group docs include private QR hash. Students never read these docs.
    allow get: if teacher() || (activityId != 'taipei2026' && enrolled(activityId,groupId));
    allow list: if teacher();
    allow create,update,delete: if false;
    match /members/{uid}{
     allow get: if teacher() || (signedIn() && request.auth.uid == uid);
     allow list: if teacher();
     // Only the independently scoped callable creates taipei2026 membership.
     allow create: if activityId != 'taipei2026'
      && signedIn() && request.auth.uid == uid
      && request.resource.data.keys().hasOnly(['inviteId','studentCode','joinedAt'])
      && request.resource.data.keys().hasAll(['inviteId','studentCode','joinedAt'])
      && request.resource.data.joinedAt == request.time
      && request.resource.data.inviteId is string
      && request.resource.data.inviteId.matches('^[a-fA-F0-9]{48}$')
      && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteId))
      && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.activityId == activityId
      && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.groupId == groupId
      && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.studentCode == request.resource.data.studentCode
      && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.claimedBy == null
      && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.claimedBy == uid;
     allow update,delete: if false;
    }
    match /missions/{missionId}{
     allow get: if teacher() || enrolled(activityId,groupId);
     allow list: if teacher();
     allow create,update,delete: if false;
    }
    match /final/{id}{
     allow get: if teacher() || enrolled(activityId,groupId);
     allow list,create,update,delete: if false;
    }
   }
  }
  match /{document=**}{allow read,write:if false;}
 }
}
