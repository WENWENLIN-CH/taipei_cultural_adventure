// DEVELOPMENT ONLY — not deployed. Test with both Storage + Firestore emulators.
// A file belongs to a specific activity, group, mission, uploader and answer key.
// Storage access is checked against the existing Firestore member/teacher documents.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function member(activityId, groupId) {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/activities/$(activityId)/groups/$(groupId)/members/$(request.auth.uid));
    }
    function teacher() {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/teacherAccess/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/teacherAccess/$(request.auth.uid)).data.authorized == true;
    }
    function photoKey(missionId, filename) {
      return (missionId == "1" && filename == 'photo1.jpg') ||
        (missionId == "2" && filename.matches('^lang[1-4]_photo\\.jpg) ||
        (missionId == "3" && filename.matches('^photo[1-2]\\.jpg) ||
        (missionId == "4" && filename.matches('^c[1-3]_photo\\.jpg) ||
        (missionId == "5" && filename.matches('^p[1-3]_photo\\.jpg);
    }
    match /activities/{activityId}/groups/{groupId}/missions/{missionId}/{uploaderUid}/{filename} {
      // Each group member may fetch an individual image; no public listing.
      allow get: if member(activityId, groupId) || teacher();
      allow list: if false;
      // One fixed file per uploader per photo slot; create-only and no random filenames.
      // Each invite permits one Firebase UID, so slots are bounded by enrolled members.
      // This is not a per-group quota and does not validate actual JPEG bytes.
      allow create: if resource == null
        && signedIn()
        && request.auth.uid == uploaderUid
        && member(activityId, groupId)
        && photoKey(missionId, filename)
        && request.resource.size > 0
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow update, delete: if false;
    }
    match /{other=**} {
      allow read, write: if false;
    }
  }
}
)) ||
        (missionId == "3" && filename.matches('^photo[1-2]-[a-f0-9]{32}\\.jpg$')) ||
        (missionId == "4" && filename.matches('^c[1-3]_photo-[a-f0-9]{32}\\.jpg$')) ||
        (missionId == "5" && filename.matches('^p[1-3]_photo-[a-f0-9]{32}\\.jpg$'));
    }
    match /activities/{activityId}/groups/{groupId}/missions/{missionId}/{uploaderUid}/{filename} {
      // Each group member may fetch an individual image; no public listing.
      allow get: if member(activityId, groupId) || teacher();
      allow list: if false;
      // Create-only: no overwrite or deletion by clients.
      allow create: if resource == null
        && signedIn()
        && request.auth.uid == uploaderUid
        && member(activityId, groupId)
        && photoKey(missionId, filename)
        && request.resource.size > 0
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow update, delete: if false;
    }
    match /{other=**} {
      allow read, write: if false;
    }
  }
}
